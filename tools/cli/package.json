{
  "name": "leitu",
  "version": "0.2.0",
  "description": "累土 leitu——给人和 AI 的确定性后端地基：查询标准答案目录（list / explain）。零依赖，只读。",
  "type": "module",
  "bin": {
    "leitu": "./leitu.mjs"
  },
  "files": [
    "leitu.mjs",
    "check-skill.mjs",
    "catalog-snapshot.json"
  ],
  "scripts": {
    "prepack": "cp ../../catalog/problems.json catalog-snapshot.json",
    "check": "node check-skill.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/helloworldtang/leitu"
  },
  "keywords": ["leitu", "spring-boot", "standard-answers", "java", "ai-agents"]
}
