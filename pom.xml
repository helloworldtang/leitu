<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.youhuale</groupId>
  <artifactId>leitu-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>

  <name>leitu</name>
  <url>https://github.com/helloworldtang/leitu</url>

  <!-- Central Portal 强制元数据：缺 <url>/<licenses>/<developers>/<scm> 四条，
        Portal 的元数学校验会直接拒收（且往往在耐心在建-empty 之后才报） -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>helloworldtang</id>
      <name>唐成</name>
      <url>https://github.com/helloworldtang</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/helloworldtang/leitu.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/helloworldtang/leitu.git</developerConnection>
    <url>https://github.com/helloworldtang/leitu</url>
  </scm>
  <description>累土——给人和 AI 的确定性后端地基：把反复出现、边界清楚的问题，沉淀成一套标准答案。</description>

  <modules>
    <module>leitu-core</module>
    <module>leitu-rules</module>
    <module>leitu-capability-access</module>
    <module>leitu-capability-data</module>
    <module>leitu-capability-cache</module>
    <module>leitu-spring-boot-starter</module>
    <module>leitu-adapter-jdbc</module>
    <module>leitu-adapter-web</module>
    <module>examples/allow-or-not</module>
    <module>examples/who-is-operating</module>
    <module>examples/access</module>
    <module>examples/what-happened</module>
    <module>examples/config-source</module>
    <module>examples/data-access</module>
    <module>examples/failure-response</module>
    <module>examples/cache</module>
    <module>examples/spring-boot</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- 自有模块的版本必须用显式属性、禁止 ${project.version}（守门人 RepoBoundaryRulesTest 强制）：
         本 pom 同时被当 BOM import 和当 parent 继承。${project.version} 在 import 时按 BOM 自身
         求值（=发布版本，正确），但被继承时会在【使用者项目】里求值（=使用者的版本号），
         去仓库找一个不存在的坐标直接解析失败——2026-09-23 外部探针实测。
         代价：发版时 versions:set 不会更新它，需同步 versions:set-property（或手动）改这一处，
         守门人断言它与 project.version 相等，漏改即构建红灯。 -->
    <leitu.version>0.2.0</leitu.version>
    <junit.version>5.11.4</junit.version>
    <archunit.version>1.3.0</archunit.version>
    <spring-boot.version>4.1.1</spring-boot.version>
    <springdoc.version>3.0.3</springdoc.version>
    <knife4j.version>5.7.5</knife4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 宿主 BOM（ADR-014）：Spring Boot 跟随当前稳定次要线；junit-bom 在其前，版本锁定先赢 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-core</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-rules</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-capability-access</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-capability-data</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-capability-cache</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-spring-boot-starter</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-adapter-jdbc</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.youhuale</groupId>
        <artifactId>leitu-adapter-web</artifactId>
        <version>${leitu.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baizhukui</groupId>
        <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
        <version>${knife4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-jdk-and-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
              <message>leitu 需要 JDK 21+ 与 Maven 3.9+（唯一的机器依赖）。修复：macOS 执行 export JAVA_HOME="$(/usr/libexec/java_home -v 21)"；Linux 用 SDKMAN 安装并设置 JAVA_HOME；CI 由 setup-java 提供。构建命令：./mvnw verify</message>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 发布到 Maven Central（Central Portal）：发布集合 = leitu-parent(pom) + core + rules + capability-access + capability-data + capability-cache
         + starter + adapter-jdbc + adapter-web，examples 不发布。需要凭据：settings 的 server id=central（User Token）+ GPG 签名。触发方式见 .github/workflows/release.yml -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <!-- 不要降到 0.7.x：0.11.0 之前，客户端解析 Portal 响应用的 ObjectMapper
                 是裸 new（Jackson 默认 FAIL_ON_UNKNOWN_PROPERTIES=true），Portal 一旦新增
                 响应字段（如 2026-09 起的 warnings）就会在「上传成功后、解析校验结果时」
                 抛 UnrecognizedPropertyException —— 包已经传上去了，构建却报失败，极难定位。
                 0.11.0 把 mapper 改成静态字段并显式 configure(FAIL_ON_UNKNOWN_PROPERTIES, false)，
                 对未知字段免疫。插件配置参数名两版完全一致，升级无需改配置。 -->
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- false = 上传后停在 Portal 待人工确认，不直接公开。
                   设 true 时上传即公开、无确认环节；首发刻意留这道闸门：
                   子模块的 url/licenses/developers/scm 靠 parent 继承，Portal 是否顺着
                   parent 解析本地验证不了，只有人工看校验报告才知道，而那是最后一次
                   能在公开前拦住问题的机会。0.2.0 走通一遍后再考虑改回 true。 -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <charset>UTF-8</charset>
              <encoding>UTF-8</encoding>
              <docencoding>UTF-8</docencoding>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- eval 参考解：默认不在 reactor 里（它是被评 agent 的对照答案，不该拖慢每次 verify），
         但必须由 CI 定期跑——它是"规则在下游真的有效"的唯一可执行证据，从未跑过的答案等于没有答案 -->
    <profile>
      <id>eval</id>
      <modules>
        <module>eval/reference/01-entity-crud-service</module>
      </modules>
    </profile>
  </profiles>
</project>
