<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.youhuale</groupId>
    <artifactId>leitu-parent</artifactId>
    <version>0.2.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>leitu-example-spring-boot</artifactId>

  <!-- 本示例是完整 Spring Boot 4 应用：Boot 4 的测试基建要求 JUnit 6（ExtensionContext.Store 新签名）。
       模块级 dependencyManagement 用 junit-bom 6.0.3 管理（其余库内模块用 ${junit.version}=5.11.4，ArchUnit 安全线）。
       根 BOM 自 0.2.1 起不再携带 junit-bom——2026-09-23 dogfood 实测它会泄漏给下游宿主，
       把 Boot 4 宿主的 JUnit 6 压回 5.11.4，testcontainers/Spring 扩展直接 NoSuchMethod。 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.0.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <name>examples :: spring-boot</name>
  <description>金样本：starter / adapter 端到端的最小可运行示范——引依赖即用（装配 / 真库 / 失败投影 / 文档端点）。</description>

  <dependencies>
    <dependency>
      <groupId>cn.youhuale</groupId>
      <artifactId>leitu-spring-boot-starter</artifactId>
    </dependency>
    <!-- 本示例自己的代码直接用了 swagger 注解（@Operation）且断言 OpenAPI bean 存在，
         所以 springdoc / knife4j 由本模块显式声明——starter 已把它们标为 optional，
         不再顺带传递。自己用到的依赖自己声明，不要靠别人传递。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baizhukui</groupId>
      <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring 控制器方法参数名靠 -parameters（Spring Boot 应用的标准编译配置） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
