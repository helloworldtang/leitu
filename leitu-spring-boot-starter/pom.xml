<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.youhuale</groupId>
    <artifactId>leitu-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>leitu-spring-boot-starter</artifactId>
  <name>leitu-spring-boot-starter</name>
  <description>装配层：引依赖即拿到全部已交付答案的默认装配（用户 Bean 优先、条件可见、分维度默认值）。见 ADR-014。</description>

  <dependencies>
    <dependency>
      <groupId>cn.youhuale</groupId>
      <artifactId>leitu-core</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.youhuale</groupId>
      <artifactId>leitu-capability-access</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.youhuale</groupId>
      <artifactId>leitu-capability-data</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.youhuale</groupId>
      <artifactId>leitu-capability-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.youhuale</groupId>
      <artifactId>leitu-adapter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.youhuale</groupId>
      <artifactId>leitu-adapter-web</artifactId>
    </dependency>
    <!-- 以下两项是「可选集成」，不是本 starter 的契约：LeituOpenApiAutoConfiguration 已用
         @ConditionalOnClass(OpenAPI.class) 保护，使用者不引 springdoc 时它不会被加载，
         也不会 ClassNotFound。标 optional 的理由：这个 starter 卖的是「判定链 + 失败交代」，
         不该把一整套 Swagger UI 全家桶（springdoc + knife4j + webjar 前端资源，几十 MB）
         强塞给每一个引它的人。需要文档增强的使用者自己显式引，examples/spring-boot 就是这么做的。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.baizhukui</groupId>
      <artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
